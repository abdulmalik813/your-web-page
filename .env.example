# APP_URL: The URL where this applet is hosted.
# Used for canonical URLs, OpenGraph metadata, sitemaps and CMS live preview.
APP_URL=""

# Email delivery configuration for /api/contact and /api/start-a-project
# Supported EMAIL_PROVIDER values: "resend" | "smtp" | "webhook" | "console"
# When left unset in development, submissions are validated and logged safely without failing.
EMAIL_PROVIDER="console"
EMAIL_TO=""
EMAIL_FROM=""
EMAIL_FROM_NAME=""

# Option 1: Resend (https://resend.com)
RESEND_API_URL="https://api.resend.com/emails"
RESEND_API_KEY=""

# Option 2: SMTP (via nodemailer)
SMTP_HOST=""
SMTP_PORT=""
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# Option 3: JSON Webhook
EMAIL_WEBHOOK_URL=""

# Payload CMS. MongoDB is used in development and production.
DATABASE_URI="mongodb://127.0.0.1:27017/payload?replicaSet=rs0&directConnection=true"
PAYLOAD_SECRET=""

# Optional; if set, must match APP_URL's origin for Payload live preview.
NEXT_PUBLIC_APP_URL=""

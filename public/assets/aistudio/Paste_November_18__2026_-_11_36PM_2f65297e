/* =============== ROUTER =============== */
function find(list,slug){for(var i=0;i<list.length;i++){if(list[i].slug===slug)return list[i]}return null}
function resolve(path){
 var p=path.split('/'),a=p[0],b=p[1];
 if(path==='')return pgHome();
 if(path==='about')return pgAbout();
 if(path==='services')return pgServices();
 if(a==='services'&&b){var s=find(SERVICES,b);return s?pgService(s):pg404()}
 if(path==='our-work')return pgWork();
 if(a==='our-work'&&b){var pr=find(PROJECTS,b);return pr?pgProject(pr):pg404()}
 if(path==='process')return pgProcess();
 if(path==='where-we-work')return pgWhere();
 if(path==='resources')return pgResources();
 if(a==='resources'&&b){var r=find(RES,b);return r?pgResource(r):pg404()}
 if(path==='faq')return pgFAQ();
 if(path==='contact')return pgContact();
 if(path==='start-a-project')return pgStart();
 if(path==='privacy')return pgPrivacy();
 if(path==='terms')return pgTerms();
 return pg404();
}
var main=$('#main'),header=$('#top'),burger=$('#burger'),first=true;
function closeMenus(){header.classList.remove('menu-open');burger.setAttribute('aria-expanded','false');burger.setAttribute('aria-label','Open menu');$$('.has-sub').forEach(function(h){h.classList.remove('open');$('.sub-toggle',h).setAttribute('aria-expanded','false')})}
function route(){
 var h=location.hash||'';
 if(h&&h.indexOf('#/')!==0)return;
 var path=h.replace(/^#\/?/,'').replace(/\/+$/,'');
 var page=resolve(path);
 main.innerHTML=page.html;
 document.title=(path===''?page.title:page.title+' — Your Web Page');
 var md=$('meta[name=description]');if(md)md.setAttribute('content',page.desc);
 var seg=path.split('/')[0];
 $$('nav a.nl').forEach(function(a){var s=a.getAttribute('href').replace('#/','').split('/')[0];if(s===seg&&seg!=='')a.setAttribute('aria-current','page');else a.removeAttribute('aria-current')});
 closeMenus();
 $$('[data-filterable]',main).forEach(applyFilter);
 fillAll();
 if(!first){window.scrollTo(0,0);main.focus({preventScroll:true})}
 first=false;
}
window.addEventListener('hashchange',route);

/* =============== FILLER CELLS =============== */
function fillGrid(g){
 $$('.filler',g).forEach(function(f){f.remove()});
 var kids=Array.prototype.filter.call(g.children,function(c){return !c.hidden});
 var cols=getComputedStyle(g).gridTemplateColumns.split(' ').filter(Boolean).length||1;
 if(cols<2||!kids.length)return;
 var add=(cols-(kids.length%cols))%cols;
 for(var i=0;i<add;i++){var d=document.createElement('div');d.className='cell filler';d.setAttribute('aria-hidden','true');g.appendChild(d)}
}
function fillAll(){$$('.grid',main).forEach(fillGrid)}
var rt;window.addEventListener('resize',function(){clearTimeout(rt);rt=setTimeout(fillAll,120)});

/* =============== FILTERS =============== */
function applyFilter(box){
 var pressed=$('.chip[aria-pressed=true]',box),active=pressed?pressed.getAttribute('data-filter'):'All';
 var si=$('[data-search]',box),q=si?si.value.trim().toLowerCase():'',shown=0;
 $$('.grid > a.cell',box).forEach(function(c){
  var ok=(active==='All'||c.getAttribute('data-key')===active)&&(!q||(c.getAttribute('data-text')||'').indexOf(q)>-1);
  c.hidden=!ok;if(ok)shown++;
 });
 var em=$('[data-empty]',box);if(em)em.hidden=shown>0;
 var ct=$('[data-count]',box);if(ct)ct.textContent=shown+(shown===1?' project':' projects');
 $$('.grid',box).forEach(fillGrid);
}
document.addEventListener('click',function(e){
 var chip=e.target.closest&&e.target.closest('.chip[data-filter]');
 if(chip){var box=chip.closest('[data-filterable]');$$('.chip',box).forEach(function(c){c.setAttribute('aria-pressed',c===chip?'true':'false')});applyFilter(box);return}
 var t=e.target.closest&&e.target.closest('.sub-toggle');
 if(t){var li_=t.closest('.has-sub'),o=!li_.classList.contains('open');li_.classList.toggle('open',o);t.setAttribute('aria-expanded',String(o));return}
 if(e.target.closest&&e.target.closest('nav a, .brand, .nav-cta'))closeMenus();
});
document.addEventListener('input',function(e){if(e.target.matches&&e.target.matches('[data-search]'))applyFilter(e.target.closest('[data-filterable]'))});

/* =============== MENU, SKIP LINK, ESC =============== */
burger.addEventListener('click',function(){var o=!header.classList.contains('menu-open');header.classList.toggle('menu-open',o);burger.setAttribute('aria-expanded',String(o));burger.setAttribute('aria-label',o?'Close menu':'Open menu')});
$('#skip').addEventListener('click',function(e){e.preventDefault();main.focus()});
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeMenus()});

/* =============== FORMS (demo only: no backend in this file) =============== */
document.addEventListener('submit',function(e){
 var f=e.target.closest&&e.target.closest('form[data-form]');if(!f)return;
 e.preventDefault();
 var bad=null;
 $$('input[required],select[required],textarea[required]',f).forEach(function(el){
  var err=$('#'+el.id+'-err',f),msg='';
  if(!el.value.trim())msg='Please fill in this field.';
  else if(el.type==='email'&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value))msg='Please enter a valid email address.';
  if(msg){el.setAttribute('aria-invalid','true');el.setAttribute('aria-describedby',el.id+'-err');if(err)err.textContent=msg;if(!bad)bad=el}
  else{el.removeAttribute('aria-invalid');if(err)err.textContent=''}
 });
 if(bad){bad.focus();return}
 /* Real build: POST to a route handler that emails hello@yourwebpage.ca. Ignore the submission if the honeypot (company_website) is filled. */
 f.outerHTML='<div class="done" role="status"><span class="tag solid" style="justify-self:start">Received</span><h2 style="font-size:clamp(1.6rem,3vw,2.4rem)">Thank you</h2><p class="lead">Your message is on its way. We aim to reply within one business day at the email address you gave us.</p><div><a class="btn alt" href="#/">Back to home</a></div></div>';
});

$('#yr').textContent=new Date().getFullYear();
route();
})();
</script>
</body>
